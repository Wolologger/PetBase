rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un documento por registro: users/{uid}/records/{id}
    match /users/{uid}/records/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['col', 'v', 'c', 't', 'd', 'rev'])
        && request.resource.data.keys().hasAll(['col', 'v', 'c', 't', 'rev'])
        && request.resource.data.col in ['pets', 'entries', 'sacks', 'settings']
        && request.resource.data.v is int && request.resource.data.v >= 2 && request.resource.data.v <= 9
        && request.resource.data.c is map && request.resource.data.t is map
        && request.resource.data.c.size() <= 500 && request.resource.data.t.size() <= 500
        && (!('d' in request.resource.data) || request.resource.data.d is string)
        && request.resource.data.rev == request.time;          // obliga a usar serverTimestamp()

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Reloj del servidor para corregir relojes mal puestos
    match /users/{uid}/meta/clock {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
